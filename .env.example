DATABASE_URL=sqlite:///./data/qcross.db
LOG_LEVEL=INFO
LAZYPORTFOLIO_BASE_URL=https://www.lazyportfolioetf.com
SAVE_RAW_SNAPSHOTS=false
RAW_SNAPSHOT_DIR=data/snapshots/lazyportfolio
EXPORT_DIR=data/exports
REPORT_DIR=data/reports
CACHE_DIR=data/cache/lazyportfolio
LOG_DIR=data/logs
ARCHIVE_DIR=data/archive
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
HTTP_MAX_ATTEMPTS=4
HTTP_BACKOFF_SECONDS=1
HTTP_MAX_RETRY_DELAY=60
LAZYPORTFOLIO_MIN_INSTRUMENTS=51
LAZYPORTFOLIO_MAX_DROP_FRACTION=0.20
RETURNS_REQUEST_INTERVAL=3
RETURNS_SAVE_RAW_SNAPSHOTS=false
