{
  "name": "qcross-portfolio-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo:sync": "node scripts/sync-demo.mjs",
    "predev": "npm run demo:sync",
    "prebuild": "npm run demo:sync",
    "format:check": "prettier --check src e2e scripts *.ts *.json index.html README.md",
    "format": "prettier --write src e2e scripts *.ts *.json index.html README.md"
  },
  "dependencies": {
    "plotly.js-cartesian-dist-min": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.6.4",
    "@types/plotly.js": "^3.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
